  "steps": [
    {
      "conclusion": "issues",
      "defects": [
        {
          "id": "customer-hold-no-longer-pauses-sla",
          "impact": "Holds caused by the customer no longer pause the resolution clock, so contracted work orders accrue elapsed time while the customer blocks the work, which produces false breaches and service credits.",
          "locations": [
            {
              "contains": "'job.held': { reasons: CUSTOMER_CAUSED_HOLDS },",
              "path": "src/sla/subscriptions.ts",
              "side": "head"
            },
            {
              "contains": "held: 'workorder.held',",
              "path": "src/workorders/model.ts",
              "side": "head"
            }
          ],
          "rubric": "The split renamed the internal hold event, but the service-level pause trigger still subscribes to the old name, so no customer-caused hold reason pauses the clock. Any reachable customer-caused hold witness with a causal explanation suffices. Public webhook topics deliberately keep their job.* names and the /jobs legacy path rewrite is retained; neither is a defect. Extra genuine source defects require independent review for all arms.",
          "severity": "high within this application's service-level contracts",
          "witnesses": [
            {
              "actual": {
                "elapsedMinutes": 240,
                "status": "running"
              },
              "expected": {
                "elapsedMinutes": 60,
                "status": "paused"
              },
              "input": {
                "hold": "customer_unavailable at 09:00",
                "observe": "12:00",
                "plan": "premium",
                "start": "Monday 08:00"
              }
            }
          ]
        }
      ],
      "evidence_obligations": [
        {
